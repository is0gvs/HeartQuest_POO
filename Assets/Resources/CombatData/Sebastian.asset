  maxHP: 38
  attackValue: 6
  defendValue: 0
  spareMessage: "* Sebasti\xE1n suspira, baja los brazos y se aleja sin decir nada."
  flavorTexts:
  - "* Sebasti\xE1n te mira con desconfianza."
  - '* Sientes que hay algo detras de tanta agresividad.'
  - '* El silencio entre ustedes se siente pesado.'
  hablarOpciones:
  - label: Preguntarle por que molesta
    playerLine: '* Le preguntas a Sebastian por que necesita hacer sentir mal a los demas.'
    mercyValue: 25
    startsBattle: 0
    enemyResponse: "* Sebasti\xE1n desvía la mirada. No esperaba esa pregunta."
  - label: Hablarle sobre el respeto
    playerLine: '* Le explicas que el respeto se gana, no se impone a la fuerza.'
    mercyValue: 20
    startsBattle: 0
    enemyResponse: "* Sebasti\xE1n se queda callado por un momento."
  - label: Decirle que no estas solo
    playerLine: '* Le dices que no vas a dejar que siga lastimando a otros porque no esta solo en esto.'
    mercyValue: 15
    startsBattle: 1
    enemyResponse: "* Sebasti\xE1n se enfurece y lanza un golpe al aire."
  - label: Ofrecerle ayuda
    playerLine: '* Le dices que si algo le pasa en casa o en el colegio, puede buscar ayuda.'
    mercyValue: 30
    startsBattle: 0
    enemyResponse: "* Los ojos de Sebasti\xE1n se humedecen por un segundo antes de voltear la cara."
  - label: Amenazar con avisar
    playerLine: '* Le adviertes que si no para, vas a hablar con un profesor.'
    mercyValue: 10
    startsBattle: 1
    enemyResponse: "* Sebasti\xE1n se rie nerviosamente pero se nota que le preocupa."
