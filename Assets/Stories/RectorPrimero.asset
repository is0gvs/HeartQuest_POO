  m_Script: {fileID: 11500000, guid: 48523a17e88479544aecb45b66eb2bb6, type: 3}
  m_Name: RectorPrimero
  m_EditorClassIdentifier: Assembly-CSharp::HeartQuest.Core.DialogueData
  lines:
  - speakerName: ?????
    text: Buenos dias joven.
    portrait: {fileID: -1764114633, guid: d7400bcf6b7f1504da8410379855ea4a, type: 3}
  - speakerName: Rector
    text: Yo soy el rector de esta institucion.
    portrait: {fileID: -1764114633, guid: d7400bcf6b7f1504da8410379855ea4a, type: 3}
  - speakerName: Rector
    text: Espero que te la pases muy bien aqui.
    portrait: {fileID: -1764114633, guid: d7400bcf6b7f1504da8410379855ea4a, type: 3}
  - speakerName: Rector
    text: Tenemos una politica muy estricta de no al bullying.
    portrait: {fileID: -1764114633, guid: d7400bcf6b7f1504da8410379855ea4a, type: 3}
  - speakerName: Rector
    text: Si algo pasa no dudes en reportarlo.
    portrait: {fileID: -1764114633, guid: d7400bcf6b7f1504da8410379855ea4a, type: 3}
